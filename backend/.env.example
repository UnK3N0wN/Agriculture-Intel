DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-use-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=agri
POSTGRES_USER=agri
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TIME_LIMIT=90
CELERY_TASK_SOFT_TIME_LIMIT=60

# mock = free testing. Use openai when you have a key.
AI_PROVIDER=mock
MOCK_DELAY_SECONDS=2
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_MAX_TOKENS_PARAM=max_completion_tokens
OPENAI_JSON_MODE=True
AI_REQUEST_TIMEOUT_SECONDS=45
AI_MAX_OUTPUT_TOKENS=2000
PLANTID_API_URL=
PLANTID_API_KEY=

WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=
WEATHER_CACHE_SECONDS=10800
CLIMATE_API_BASE_URL=https://archive-api.open-meteo.com/v1/archive
CLIMATE_NORMALS_YEARS=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
THROTTLE_ANON=120/hour
THROTTLE_USER=5000/day
THROTTLE_REGISTER=5/hour
THROTTLE_AI_SUBMIT=10/hour
AI_DAILY_CAP_PER_USER=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

UPLOAD_MAX_BYTES=8388608
UPLOAD_MAX_PIXELS=25000000
UPLOAD_MAX_SIDE=1600
PRIVATE_MEDIA_ROOT=private_media